# ===========================
# FixFirst AI - .gitignore
# ===========================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual Environment
venv/
env/
.venv/
.env/

# Database (contains local data)
*.db
*.sqlite
*.sqlite3

# Uploads (user uploaded files)
backend/uploads/*
!backend/uploads/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Node
node_modules/
frontend/node_modules/

# Vite build output
frontend/dist/

# Logs
*.log
logs/

# Environment files
.env
.env.local
.env.production

# Temporary files
*.tmp
*.temp

# Graphify output (if generated)
graphify_output/

frontend/.env.development
backend/*.db.backup

graphify-out/
backend/graphify-out/
