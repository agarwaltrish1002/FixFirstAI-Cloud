# FixFirst AI - Environment Configuration Example
# Copy to .env for custom overrides (DO NOT commit secrets to GitHub)

# Server Ports
PORT=8001
BACKEND_PORT=8001
FRONTEND_PORT=5174

# AI Provider Configuration
# Options: "gemini" (default in production) or "ollama_cloud" or "ollama_local"
AI_PROVIDER=gemini

# Gemini Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Ollama Cloud Settings
# Endpoint: https://ollama.com/api/chat
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
OLLAMA_MODEL=gemma4:31b

# Local Ollama Settings (Optional, when running locally)
OLLAMA_URL=http://localhost:11434

# Production CORS - comma-separated list of allowed frontend domains
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,https://fix-first-ai-cloud.vercel.app
