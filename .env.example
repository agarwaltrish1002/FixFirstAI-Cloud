# FixFirst AI - Environment Configuration Example
# Copy this to .env for local development (DO NOT commit .env to GitHub)
# Set these variables in Render.com / Vercel for production deployments.

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8001
BACKEND_PORT=8001
FRONTEND_PORT=5174

# ── Security ───────────────────────────────────────────────────────────────
# REQUIRED: Generate a strong random secret for JWT signing.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret-key-here

# ── AI Provider ────────────────────────────────────────────────────────────
# Options: "openai" (default) | "gemini" | "ollama_cloud" | "ollama_local"
AI_PROVIDER=openai

# ── OpenAI Settings (Primary AI Provider) ──────────────────────────────────
# REQUIRED for OpenAI provider. Never commit this value to GitHub.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1

# ── Gemini Settings (Fallback Provider) ────────────────────────────────────
# Used as fallback if OpenAI is unavailable, or when AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Ollama Cloud Settings (Optional) ───────────────────────────────────────
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
OLLAMA_MODEL=gemma4:31b

# ── Local Ollama Settings (Optional, for local development only) ────────────
OLLAMA_URL=http://localhost:11434

# ── CORS ───────────────────────────────────────────────────────────────────
# Production: Add your Vercel / custom domain here
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,https://fix-first-ai-cloud.vercel.app
